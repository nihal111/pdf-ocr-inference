diff --color -ru .upstream/nanovllm/__init__.py nanovllm/__init__.py
--- .upstream/nanovllm/__init__.py	2026-10-25 17:06:50
+++ nanovllm/__init__.py	2026-10-25 17:06:59
@@ -1,2 +1,10 @@
-from nanovllm.llm import LLM
-from nanovllm.sampling_params import SamplingParams
+# Lazy exports so the scheduler/block manager can be imported without torch or
+# flash-attn (lets the lab's mock engine run on machines without a GPU).
+def __getattr__(name):
+    if name == "LLM":
+        from nanovllm.llm import LLM
+        return LLM
+    if name == "SamplingParams":
+        from nanovllm.sampling_params import SamplingParams
+        return SamplingParams
+    raise AttributeError(name)
